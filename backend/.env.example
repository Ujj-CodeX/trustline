# Django
SECRET_KEY=replace-with-a-generated-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=trustline_db
DB_USER=postgres
DB_PASSWORD=replace-with-your-local-password
DB_HOST=localhost
DB_PORT=5432

# Optional external services
# When omitted, TrustLine falls back to Argos translation and then original text.
GOOGLE_TRANSLATE_API_KEY=
GROQ_API_KEY=
