{
  "version": "1.0",
  "purpose": "Seed evaluation set for TrustLine scope-router calibration.",
  "label_schema": {
    "in_scope": "The request is about finding or accessing a support service in TrustLine's supported categories.",
    "out_of_scope": "The request is clearly unrelated to support or helpline discovery, including small talk, entertainment, unrelated coding, trivia, and random text.",
    "needs_clarification": "The request may be support-related, is underspecified, or has ambiguous safety context. Safety-sensitive examples must not be automatically rejected as out of scope."
  },
  "notes": [
    "These are manually authored seed labels for initial evaluation, not a validated gold-standard dataset or a claim of production accuracy.",
    "Use this set to inspect false acceptance and false rejection and to calibrate thresholds before enabling hard routing.",
    "Context is synthetic and represents recent transient conversation messages for follow-up tests; do not persist it as server-side chat history.",
    "An explicit or plausible safety signal must never be routed to out_of_scope solely because embedding similarity is low.",
    "Keep a separate holdout set when tuning thresholds; do not tune and report performance on the same cases."
  ],
  "counts": {
    "in_scope": 67,
    "out_of_scope": 28,
    "needs_clarification": 25
  },
